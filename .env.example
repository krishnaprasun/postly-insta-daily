# Seeded from ~/postly_image_pipeline/.env  — NOT committed (.gitignore)

# ── LiteLLM (Classplus proxy): text briefs + Gemini image gen ──
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_TEXT_MODEL=

# ── Fallback direct Gemini key (used only if LITELLM_* is unset) ──
GOOGLE_CLOUD_API_KEY=

# ── Postly CDN: public image hosting (needed later for IG publish) ──
POSTLY_CDN_URL=
POSTLY_CDN_ACCESS_TOKEN=

# ── Review UI ──
PUBLIC_BASE_URL=
ADMIN_USER=
ADMIN_PASS=
SECRET_KEY=

# ── Daily run (IST) ──
SCHEDULER_ENABLED=
RUN_HOUR_IST=
RUN_MINUTE_IST=
VARIANT_COUNT=

# ── Notification: none | email ──
NOTIFY_CHANNEL=
NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Instagram publishing — OFF until Graph API access exists ──
IG_PUBLISH_ENABLED=
IG_USER_ID=
IG_ACCESS_TOKEN=
